# コピーして .env.local を作り、値を入れてください(.env.local はコミットされません)
#   cp .env.example .env.local

# MapTiler(地図タイル・場所検索)。https://cloud.maptiler.com/account/keys/
# ブラウザに公開されるキーなので、MapTiler 側で「許可するドメイン」を必ず設定してください。
# 未設定でも地図はキー不要の代替地図(OpenFreeMap)で表示されます。
NEXT_PUBLIC_MAPTILER_KEY=

# 地図の見た目(任意)。streets-v2 / basic-v2 / pastel など
NEXT_PUBLIC_MAPTILER_STYLE=streets-v2

# OpenRouteService(ルート検索)。https://openrouteservice.org/dev/#/signup
# サーバー側(Route Handler)だけで使います。NEXT_PUBLIC_ を付けないこと。
ORS_API_KEY=
